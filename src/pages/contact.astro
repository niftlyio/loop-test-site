---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
---

<Base title="Contact" description={`Opening hours, phone number and address for ${site.name}.`}>
  <h1>Contact</h1>
  <p>
    Call us on <a href={`tel:${site.phone}`}>{site.phone}</a> or email
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>
  <p>{site.address}</p>

  <h2>Opening hours</h2>
  <table>
    <thead>
      <tr>
        <th scope="col">Days</th>
        <th scope="col">Hours</th>
      </tr>
    </thead>
    <tbody>
      {site.hours.map((row) => (
        <tr>
          <th scope="row">{row.days}</th>
          <td>{row.open && row.close ? `${row.open} to ${row.close}` : "Closed"}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
